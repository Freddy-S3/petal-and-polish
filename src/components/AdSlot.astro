---
// Reusable AdSense placeholder slot.
//
// This renders an <ins class="adsbygoogle"> block and pushes it once the
// adsbygoogle loader script (added in BaseLayout.astro) has run. Publisher ID
// comes from src/config/ads.ts so it only needs to change in one place.
import { ADSENSE_PUBLISHER_ID } from "../config/ads";

interface Props {
  slot: string;
  format?: string;
  label: string;
}

const { slot, format = "auto", label } = Astro.props;
---

<div class="ad-slot" aria-label={label}>
  <span class="ad-slot__label">{label}</span>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={ADSENSE_PUBLISHER_ID}
    data-ad-slot={slot}
    data-ad-format={format}
    data-full-width-responsive="true"></ins>
</div>

<script is:inline>
  (adsbygoogle = window.adsbygoogle || []).push({});
</script>

<style>
  .ad-slot {
    margin: 2rem 0;
    padding: 0.9rem;
    border: 1px dashed var(--color-border);
    border-radius: 14px;
    text-align: center;
    background: var(--color-surface-soft);
  }
  .ad-slot__label {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }
</style>
