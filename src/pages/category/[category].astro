---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_NAME } from "../../config/site";

export async function getStaticPaths() {
  return [
    { params: { category: "nail-art" }, props: { label: "Nail art" } },
    { params: { category: "nail-health" }, props: { label: "Nail health" } },
    { params: { category: "general" }, props: { label: "General" } },
  ];
}

const { category } = Astro.params;
const { label } = Astro.props;

const allPosts = await getCollection("posts", ({ data }) => !data.draft && data.category === category);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout title={`${label} — ${SITE_NAME}`} description={`${label} posts from ${SITE_NAME}.`}>
  <h1>{label}</h1>
  {
    posts.length === 0 ? (
      <p>No posts here yet — check back soon.</p>
    ) : (
      <ul class="post-grid">
        {posts.map((post) => (
          <li class="post-card">
            <h3>
              <a href={`/${post.slug}/`}>{post.data.title}</a>
            </h3>
            <div class="post-meta">{formatDate(post.data.pubDate)}</div>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
  <p><a class="back-link" href="/">&larr; Back to all posts</a></p>
</BaseLayout>
