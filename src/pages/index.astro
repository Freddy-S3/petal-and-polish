---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_NAME } from "../config/site";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featured, ...rest] = posts;

function excerpt(body: string, length = 220) {
  const plain = body
    .replace(/^---[\s\S]*?---/, "")
    .replace(/[#*`>_[\]()]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  return plain.length > length ? `${plain.slice(0, length).trim()}…` : plain;
}

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
}

const categoryLabel: Record<string, string> = {
  "nail-art": "Nail art",
  "nail-health": "Nail health",
  general: "General",
};
---

<BaseLayout title={`${SITE_NAME} — nail art, nail care, and nail health notes`}>
  <h1 class="visually-hidden">{SITE_NAME} — nail art, nail care, and nail health notes</h1>

  {
    featured && (
      <section class="hero">
        <p class="hero-kicker">Latest post</p>
        <h2>
          <a href={`/${featured.slug}/`}>{featured.data.title}</a>
        </h2>
        <div class="post-meta">
          {formatDate(featured.data.pubDate)} · <span class="category-pill">{categoryLabel[featured.data.category]}</span>
        </div>
        <p class="hero-excerpt">{featured.data.description || excerpt(featured.body, 260)}</p>
        <a class="read-more" href={`/${featured.slug}/`}>Read the post &rarr;</a>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <>
        <p class="section-label">More posts</p>
        <ul class="post-grid">
          {rest.map((post) => (
            <li class="post-card">
              <h3>
                <a href={`/${post.slug}/`}>{post.data.title}</a>
              </h3>
              <div class="post-meta">
                {formatDate(post.data.pubDate)} · <span class="category-pill">{categoryLabel[post.data.category]}</span>
              </div>
              <p>{post.data.description || excerpt(post.body)}</p>
              <div class="tag-row">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </li>
          ))}
        </ul>
      </>
    )
  }
</BaseLayout>
